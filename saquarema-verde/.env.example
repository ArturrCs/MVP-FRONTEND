# Copie este arquivo para ".env" (sem o .example) e preencha com os dados do seu projeto Supabase:
# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public
# NUNCA coloque a chave "service_role" aqui nem em nenhum arquivo do site.
